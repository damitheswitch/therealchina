# Supabase (public, safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-project-anon-or-publishable-key

# Cloudflare Turnstile (public site key)
# Get this from Cloudflare Dashboard > Turnstile > your widget
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Umami Cloud review analytics (public website ID). Leave unset to disable.
# Allowed hostnames are exact matches: production only on the live domain,
# staging only on the exact staging hostname. Localhost is not included.
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_ALLOWED_HOSTNAMES=
# Optional overrides for a proxy or a local fake tracker during verification.
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_HOST_URL=
