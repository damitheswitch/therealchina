# Local Edge Function environment variables
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by the
# local `supabase functions serve` runtime, so do not add them here.
# If a name starts with SUPABASE_, the CLI will skip it.

# Supabase project reference for CLI config.toml (env() substitution).
# The CLI reads this file for config.toml env() values, but skips SUPABASE_*
# variables when passing env to Edge Functions, so this does not leak there.
SUPABASE_PROJECT_ID=your-project-id

# Cloudflare Turnstile server-side secret.
# Use your production secret in Supabase secrets.
# For local testing, copy this file to .env.local and use Cloudflare's official
# test secret: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Optional but recommended in production: hostname allowlist for the Turnstile
# token. Comma-separated, no scheme, no trailing slash. The siteverify response
# hostname must match one of these. Leave unset for local dev (skipped).
# Never include localhost or 127.0.0.1 here.
# TURNSTILE_HOSTNAMES=therealchina.netlify.app

# Optional: restrict CORS to your production Netlify domain.
# Leave commented out or set to "*" for local dev.
# CORS_ORIGIN=https://your-netlify-domain.netlify.app
